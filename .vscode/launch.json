{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run prediction API",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["api.app:app", "--reload", "--port", "8000"],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "MLFLOW_DISABLE_AGENT_HINT": "1"
            },
            "jinja": true,
            "justMyCode": true
        }
    ]
}
